# منفذ السيرفر (افتراضيا 2222)
PORT=2222

# توكن فيسبوك الرئيسي للوكالة (Default Meta Access Token)
META_ACCESS_TOKEN=

# توكن ثريدز (اختياري)
THREADS_ACCESS_TOKEN=

# النطاق الخاص بك على الـ VPS لشهادة الـ SSL التلقائية
DOMAIN=mcp.yourdomain.com

# رابط الاتصال بقاعدة بيانات PostgreSQL (اختياري، إذا لم يحدد يُستخدم ملف JSON محلي)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/meta_mcp
DATABASE_URL=
